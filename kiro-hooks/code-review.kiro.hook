{
  "enabled": true,
  "name": "Code Review",
  "version": "1.0.0",
  "description": "Automatically reviews code after the agent writes or edits a file, checking for bugs, security issues, and best practices.",
  "when": {
    "type": "postToolUse",
    "toolTypes": ["write"]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Review the code you just wrote. Check for: potential bugs, security issues (hardcoded secrets, injection risks), missing error handling, unused imports, and any obvious improvements. Be brief — only flag real issues, not style nitpicks."
  }
}
